# Configuration de l'API Duel by Benribs Lab

# Port du serveur
PORT=3003

# Environnement (development, production, test)
NODE_ENV=development

# ===== CONFIGURATION BASE DE DONNÉES =====

# Base de données SQLite (par défaut).
# Un chemin relatif est résolu depuis la racine de duel-api ; en Docker, utilisez
# le chemin absolu du volume : file:/app/prisma/dev.db
SQLITE_URL="file:./prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Création du schéma au démarrage. À laisser sur false : ne passer à true que
# pour une première installation, puis remettre false (voir docs/DB_MIGRATION.md).
RUN_DB_SCHEMA_SYNC=false

# Configuration de base de données dynamique
# DB_PROVIDER: sqlite ou mysql
DB_PROVIDER=sqlite

# Configuration MySQL (pour migration automatique)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duel
DB_USER=votre_utilisateur_mysql
DB_PASS=votre_mot_de_passe_mysql

# ===== AUTHENTIFICATION =====

# Secret pour JWT (OBLIGATOIRE - changez en production !)
JWT_SECRET=
JWT_EXPIRES_IN=24h
OTP_SECRET=
TRACKING_SECRET=
PARENTAL_CONSENT_SECRET=

# Administration
ADMIN_USERNAME=admin
# Générer avec: node -e "require('bcryptjs').hash(process.argv[1],12).then(console.log)" 'mot-de-passe'
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=1h

# ===== SÉCURITÉ ET CORS =====

# CORS - Domaines autorisés (séparés par des virgules)
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:5173,https://votre-site-escrime.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sécurité API
API_KEY_HEADER=X-API-Key
API_KEY=votre_cle_api_changez_moi_aussi

# ===== EMAILS ET NOTIFICATIONS =====

# Microsoft Graph pour l'envoi d'emails
AZURE_CLIENT_ID=votre_client_id_azure
AZURE_CLIENT_SECRET=votre_client_secret_azure
AZURE_TENANT_ID=votre_tenant_id_azure
GRAPH_SENDER_EMAIL=contact@votre-domaine.com
GRAPH_SENDER_NAME="[Duel By Benribs Lab]"

# Adresse recevant les signalements de contenu/comportement (voir POST /api/duels/:id/signaler).
# Sans cette valeur, les signalements restent enregistrés en base mais aucun e-mail n'est envoyé.
ADMIN_NOTIFICATION_EMAIL=contact@votre-domaine.com

# Configuration OTP
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60

# Relais devant l'API. OBLIGATOIRE derrière un reverse proxy : sans cette valeur,
# la limitation de débit s'applique à un compteur global partagé par tous les
# clients, et 10 échecs de connexion suffisent à bloquer tout le monde.
# Soit un nombre de relais à traverser (1 = un seul proxy devant l'API),
# soit une liste d'IP/CIDR séparées par des virgules.
TRUSTED_PROXIES=1

# Firebase Admin SDK (pour push notifications)
# Pour obtenir ces valeurs:
# 1. Aller sur https://console.firebase.google.com/project/VOTRE_PROJECT/settings/serviceaccounts/adminsdk
# 2. Cliquer "Generate new private key"
# 3. Télécharger le fichier JSON et extraire les valeurs
FIREBASE_PRIVATE_KEY_ID=votre_private_key_id_firebase
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_FIREBASE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com

# ===== LOGS ET MONITORING =====

# Niveau de logs
LOG_LEVEL=info
