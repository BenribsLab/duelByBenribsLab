{
  "name": "duel-by-benribs-lab-api",
  "version": "1.0.0",
  "description": "API Backend pour l'application Duel by Benribs Lab - Gestion de duels d'escrime",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npx prisma generate && npm run lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "escrime",
    "fencing",
    "duel",
    "api",
    "nodejs",
    "express",
    "prisma",
    "sqlite"
  ],
  "author": "Benribs Lab",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^6.7.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
